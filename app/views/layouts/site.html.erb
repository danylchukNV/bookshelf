<% content_for :head do %>
  <%= stylesheet_link_tag 'appstack/light.css', 'data-turbo-track': 'reload' %>
  <%= javascript_import_module_tag 'appstack' %>
<% end %>

<div class="wrapper">
  <nav id="sidebar" class="sidebar">
    <div class="sidebar-content js-simplebar">
      <%= link_to root_path, class: 'sidebar-brand' do %>
        <span class="align-middle">Bookshelf</span>
      <% end %>
      <ul class="sidebar-nav">
        <li class="sidebar-header">Library</li>
        <li class="sidebar-item <%= active_class(books_path) %>">
          <%= link_to books_path, class: 'sidebar-link' do %>
            <i class="fa-solid fa-book"></i>
            <span class="align-middle">Books</span>
          <% end %>
        </li>
        <li class="sidebar-item <%= active_class(authors_path) %>">
          <%= link_to authors_path, class: 'sidebar-link' do %>
            <i class="fa-solid fa-user-pen"></i>
            <span class="align-middle">Authors</span>
          <% end %>
        </li>
        <% if admin_signed_in? %>
          <li class="sidebar-header">Admin</li>
          <li class="sidebar-item">
            <%= link_to new_admin_import_path, class: 'sidebar-link' do %>
              <i class="fa-solid fa-file-import"></i>
              <span class="align-middle">Import Books</span>
            <% end %>
          </li>
          <li class="sidebar-item">
            <%= link_to admin_path, class: 'sidebar-link' do %>
              <i class="fa-solid fa-sliders"></i>
              <span class="align-middle">Admin panel</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </nav>

  <div class="main">
    <nav class="navbar navbar-expand navbar-light navbar-bg">
      <a class="sidebar-toggle">
        <i class="hamburger align-self-center"></i>
      </a>
      <div class="navbar-collapse collapse">
        <ul class="navbar-nav navbar-align align-items-center">
          <% if admin_signed_in? %>
            <li class="nav-item me-2"><span class="text-muted"><%= current_admin.email %></span></li>
            <li class="nav-item">
              <%= button_to 'Sign out', destroy_admin_session_path, method: :delete,
                            class: 'btn btn-sm btn-outline-secondary' %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to 'Sign in', new_admin_session_path, class: 'btn btn-sm btn-outline-primary' %>
            </li>
          <% end %>
        </ul>
      </div>
    </nav>
    <%= render('shared/flash') %>
    <%= yield %>
  </div>
</div>

<% parent_layout 'base' %>
