<%= form_with model: author do |f| %>
  <%= render 'admin_panel/partials/form_errors', object: author %>

  <div class="mb-3">
    <%= f.label :name, class: 'form-label' %>
    <%= f.text_field :name, class: "form-control #{'is-invalid' if author.errors[:name].any?}", placeholder: 'Name' %>
  </div>

  <div class="mb-3">
    <%= f.label :bio, class: 'form-label' %>
    <%= f.text_area :bio, rows: 4, class: 'form-control', placeholder: 'Short biography' %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :active, class: 'form-check-input' %>
    <%= f.label :active, 'Active (can be selected for new books)', class: 'form-check-label' %>
  </div>

  <%= f.submit 'Save', class: 'btn btn-primary' %>
  <%= link_to 'Back', authors_path, class: 'btn btn-outline-secondary' %>
<% end %>
