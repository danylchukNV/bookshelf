<%= form_with model: book do |f| %>
  <%= render 'admin_panel/partials/form_errors', object: book %>

  <div class="row">
    <div class="mb-3 col-md-6">
      <%= f.label :title, class: 'form-label' %>
      <%= f.text_field :title, class: "form-control #{'is-invalid' if book.errors[:title].any?}", placeholder: 'Title' %>
    </div>
    <div class="mb-3 col-md-6">
      <%= f.label :author_id, 'Author', class: 'form-label' %>
      <%= f.collection_select :author_id, author_options, :id, :name,
                              { include_blank: '— Select author —' }, class: 'form-select' %>
    </div>
  </div>

  <div class="mb-3 col-md-3">
    <%= f.label :year, class: 'form-label' %>
    <%= f.number_field :year, class: "form-control #{'is-invalid' if book.errors[:year].any?}", placeholder: '1900–2030' %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: 'form-label' %>
    <%= f.text_area :description, rows: 4, class: 'form-control', placeholder: 'Description' %>
  </div>

  <% if admin_signed_in? %>
    <div class="mb-3">
      <%= f.label :cover, 'Cover', class: 'form-label' %>
      <div class="d-flex align-items-start gap-3">
        <div>
          <% if book.cover %>
            <%= image_tag book.cover_url, alt: 'Cover', class: 'img-thumbnail', style: 'max-height: 180px;',
                                          id: 'cover-preview' %>
          <% else %>
            <%= tag.img alt: '', class: 'img-thumbnail d-none', style: 'max-height: 180px;', id: 'cover-preview' %>
          <% end %>
        </div>
        <div class="flex-grow-1">
          <%# keeps an already uploaded file when the form is shown again with validation errors %>
          <%= f.hidden_field :cover, value: book.cached_cover_data, id: nil %>
          <%= f.file_field :cover, accept: 'image/jpeg,image/png,image/webp,image/gif',
                                   class: "form-control #{'is-invalid' if book.errors[:cover].any?}",
                                   onchange: "const p=document.getElementById('cover-preview');" \
                                             "if(this.files[0]){p.src=URL.createObjectURL(this.files[0]);" \
                                             "p.classList.remove('d-none');}" %>
          <div class="form-text">JPEG, PNG, WebP or GIF, up to 5 MB.</div>
          <% if book.cover && book.persisted? %>
            <div class="form-check mt-2">
              <%= f.check_box :remove_cover, class: 'form-check-input' %>
              <%= f.label :remove_cover, 'Remove cover', class: 'form-check-label' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= f.submit 'Save', class: 'btn btn-primary' %>
  <%= link_to 'Back', books_path, class: 'btn btn-outline-secondary' %>
<% end %>
