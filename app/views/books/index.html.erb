<% provide(:title, 'Books') %>
<main class="content">
  <div class="container-fluid p-0">
    <div class="card">
      <div class="card-header">
        <% if admin_signed_in? %>
          <%= link_to new_admin_import_path, class: 'btn btn-outline-primary float-end mt-n1 ms-1' do %>
            <i class="fa-solid fa-file-import"></i>
            Import Books
          <% end %>
        <% end %>
        <%= link_to new_book_path, class: 'btn btn-primary float-end mt-n1' do %>
          <i class="fa-solid fa-plus"></i>
          New Book
        <% end %>
        <h1 class="h3 mb-3">Books</h1>

        <%= search_form_for @q, html: { class: 'row g-2' } do |f| %>
          <%= hidden_field_tag 'q[s]', params.dig(:q, :s) if params.dig(:q, :s).present? %>
          <div class="col-md-5">
            <%= f.search_field :title_cont, class: 'form-control', placeholder: 'Search by title' %>
          </div>
          <div class="col-md-4">
            <%= f.collection_select :author_id_eq, @authors, :id, :name,
                                    { include_blank: 'All authors' }, class: 'form-select' %>
          </div>
          <div class="col-md-3 d-flex gap-1">
            <%= f.submit 'Search', class: 'btn btn-outline-primary' %>
            <%= link_to 'Reset', books_path, class: 'btn btn-outline-secondary' %>
          </div>
        <% end %>
      </div>
      <div class="card-body">
        <% if @books.any? %>
          <div class="table-responsive">
            <table class="table table-striped mb-0">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Cover</th>
                  <th scope="col"><%= sort_link(@q, :title, 'Title') %></th>
                  <th scope="col">Author</th>
                  <th scope="col"><%= sort_link(@q, :year, 'Year') %></th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @books.each do |book| %>
                  <tr>
                    <td><%= book.id %></td>
                    <td>
                      <% if book.cover %>
                        <%= image_tag book.cover_url, alt: '', style: 'height: 48px;', class: 'rounded' %>
                      <% end %>
                    </td>
                    <td><%= link_to book.title, book_path(book) %></td>
                    <td><%= book.author&.name || '—' %></td>
                    <td><%= book.year %></td>
                    <td>
                      <div class="d-flex gap-1">
                        <%= link_to 'Edit', edit_book_path(book), class: 'btn btn-sm btn-warning' %>
                        <%= button_to 'Delete', book_path(book), method: :delete,
                                      class: 'btn btn-sm btn-danger',
                                      form: { data: { turbo_confirm: "Delete \"#{book.title}\"?" } } %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="mb-0">No books found.</p>
        <% end %>
      </div>
    </div>
  </div>
</main>
