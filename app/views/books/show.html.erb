<% provide(:title, @book.title) %>
<main class="content">
  <div class="container-fluid p-0">
    <div class="card">
      <div class="card-header">
        <h1 class="h3 mb-0"><%= @book.title %></h1>
      </div>
      <div class="card-body d-flex gap-4">
        <% if @book.cover %>
          <div><%= image_tag @book.cover_url, alt: @book.title, class: 'img-thumbnail', style: 'max-height: 300px;' %></div>
        <% end %>
        <dl class="row mb-0 flex-grow-1">
          <dt class="col-sm-2">Author</dt>
          <dd class="col-sm-10"><%= @book.author&.name || '—' %></dd>
          <dt class="col-sm-2">Year</dt>
          <dd class="col-sm-10"><%= @book.year %></dd>
          <dt class="col-sm-2">Description</dt>
          <dd class="col-sm-10"><%= simple_format(@book.description) %></dd>
        </dl>
      </div>
      <div class="card-footer d-flex gap-1">
        <%= link_to 'Edit', edit_book_path(@book), class: 'btn btn-warning' %>
        <%= button_to 'Delete', book_path(@book), method: :delete, class: 'btn btn-danger',
                      form: { data: { turbo_confirm: "Delete \"#{@book.title}\"?" } } %>
        <%= link_to 'Back', books_path, class: 'btn btn-outline-secondary' %>
      </div>
    </div>
  </div>
</main>
